{
  "name": "rxtrack",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "prisma:generate": "prisma generate --config ./backend/prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config ./backend/prisma.config.ts",
    "prisma:validate": "prisma validate --config ./backend/prisma.config.ts",
    "prisma:seed": "prisma db seed --config ./backend/prisma.config.ts",
    "prisma:verify-seed": "tsx database/prisma/verify-seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "tsx": "^4.20.3"
  }
}
