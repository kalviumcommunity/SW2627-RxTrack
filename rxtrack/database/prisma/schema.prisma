generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DOCTOR
  PHARMACY
  ADMIN
}

enum PrescriptionStatus {
  PENDING
  PROCESSING
  READY
  DISPENSED
  REJECTED
}

enum FulfillmentStatus {
  PENDING
  QUEUED
  READY
  COMPLETED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  prescriptions Prescription[] @relation("DoctorPrescriptions")
  pharmacy      Pharmacy?      @relation("UserPharmacy")
}

model Pharmacy {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String? @unique
  user   User?   @relation("UserPharmacy", fields: [userId], references: [id])

  fulfillments Fulfillment[]

  @@index([name])
}

model Prescription {
  id          String             @id @default(uuid())
  patientName String
  doctorId    String
  imageUrl    String?
  status      PrescriptionStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  doctor      User                 @relation("DoctorPrescriptions", fields: [doctorId], references: [id], onDelete: Restrict)
  medicines   PrescriptionMedicine[]
  fulfillments Fulfillment[]

  @@index([doctorId])
  @@index([status])
}

model Medicine {
  id               String   @id @default(uuid())
  name             String
  genericName      String?
  strength         String?
  form             String?
  stockQuantity    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  prescriptionMedicines PrescriptionMedicine[]

  @@unique([name, strength, form], map: "medicine_name_strength_form_unique")
  @@index([name])
}

model PrescriptionMedicine {
  id             String   @id @default(uuid())
  prescriptionId String
  medicineId     String
  quantity       Int      @default(1)
  dosage         String?
  instructions   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine     @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@unique([prescriptionId, medicineId])
  @@index([prescriptionId])
  @@index([medicineId])
}

model Fulfillment {
  id            String          @id @default(uuid())
  prescriptionId String
  pharmacyId    String
  status        FulfillmentStatus @default(PENDING)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  pickedUpAt    DateTime?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  pharmacy     Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@unique([prescriptionId, pharmacyId])
  @@index([prescriptionId])
  @@index([pharmacyId])
  @@index([status])
}
